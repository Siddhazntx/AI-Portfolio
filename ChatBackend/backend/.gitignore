# ==========================================
# Backend .gitignore (FastAPI + Python)
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Cpython cache
*.cpython-*

# Virtual Environments
.venv/
venv/
env/

# Environment variables & secrets
.env
.env.*
*.env
!.env.example

# Logs and temp files
*.log
logs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

